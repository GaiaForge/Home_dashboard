/**
 * Copy this file to secrets.h and fill in your own values.
 * secrets.h is gitignored — it never gets committed.
 */
#pragma once

#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASS       "your-wifi-password"

/* MicroClimate Monitor server (read-only: the board only issues GETs). */
#define MC_SERVER       "http://192.168.1.x:3000"

#define MC_GMT_OFFSET   0         /* seconds; e.g. 7200 = UTC+2 */

/* Optional default weather location (0 = unset). Normally you set this on
 * the board via Settings > Location; this is only a first-run seed. */
#define MC_LAT          0.0
#define MC_LNG          0.0

/* Nous A5T (Tasmota) power strip — set to its IP once it's on the network.
 * Also settable on-device via Settings > Set pump IP, which takes priority
 * over this once set — this is only a first-run seed. */
#define PUMP_HOST       "192.168.1.x"

/* Only needed if the strip has a Tasmota web password set (default: none —
 * leave these empty). Default Tasmota username is "admin". */
#define PUMP_USER       ""
#define PUMP_PASS       ""
