/**
 * Copy this file to secrets.h and fill in your own values.
 * secrets.h is gitignored — it never gets committed.
 */
#pragma once

#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASS       "your-wifi-password"

/* MicroClimate server — read-only, only used to fetch field-node soil % for
 * threshold watering. The valve node never writes to it. */
#define MC_SERVER       "http://192.168.1.x:3000"

/* mDNS name -> the panel reaches this node at <name>.local.
 * IMPORTANT: every physical valve-controller board needs a UNIQUE hostname,
 * or clients will nondeterministically flip between boards. */
#define VALVE_HOSTNAME  "gaiaforge-valve"

#define GMT_OFFSET_SEC  0         /* seconds; e.g. 7200 = UTC+2 */

/* Nous A5T (Tasmota) power strip — only needed if a zone targets a pump
 * outlet (Zone.device=1) instead of a local relay. */
#define PUMP_HOST       "192.168.1.x"
